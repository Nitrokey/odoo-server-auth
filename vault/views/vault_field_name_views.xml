<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_vault_field_name_tree" model="ir.ui.view">
        <field name="model">vault.field.name</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name" />
            </list>
        </field>
    </record>

    <record id="view_vault_field_name_form" model="ir.ui.view">
        <field name="model">vault.field.name</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_vault_field_name_search" model="ir.ui.view">
        <field name="model">vault.field.name</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" operator="ilike" />
            </search>
        </field>
    </record>

    <record id="action_vault_field_name" model="ir.actions.act_window">
        <field name="name">Field Names</field>
        <field name="res_model">vault.field.name</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
